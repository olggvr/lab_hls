# Скопируй в .env и при необходимости поменяй значения.
# Без .env docker compose возьмёт значения по умолчанию из docker-compose.yml.
DB_NAME=school
DB_USER=school
DB_PASSWORD=school
DB_PORT=5432
APP_PORT=8080
# demo — загрузить демо-данные; prod — только схема, без демо-данных
LIQUIBASE_CONTEXTS=demo
